rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function signed() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function ownsNew(f) { return signed() && request.resource.data[f] == me(); }
    function owns(f) { return signed() && resource.data[f] == me(); }
    // আপডেটে মালিক বদলানো যাবে না
    function sameOwner(f) { return request.resource.data[f] == resource.data[f]; }
    // ১৮+ ফ্ল্যাগ ইউজার সরাতে পারবে না
    function adultOk() {
      return resource.data.get('flagWhy', '') != 'adult' ||
        (request.resource.data.get('flagged', false) == true &&
         request.resource.data.get('flagWhy', '') == 'adult');
    }

    // ভেরিফাইড ব্যাজ: ইউজার নিজে বসাতে বা বদলাতে পারবে না (শুধু Console/Admin SDK)
    match /profiles/{uid} {
      allow read: if signed();
      allow create: if signed() && uid == me()
        && request.resource.data.get('verified', false) == false;
      allow update: if signed() && uid == me()
        && request.resource.data.get('verified', false) == resource.data.get('verified', false);
      allow delete: if signed() && uid == me();
    }
    match /private/{uid} {
      allow read, write: if signed() && uid == me();
    }
    match /blocks/{id} {
      allow read: if signed() && (resource.data.from == me() || resource.data.to == me());
      allow create: if ownsNew('from');
      allow delete: if owns('from');
    }

    match /posts/{id} {
      allow read: if signed();
      allow create: if ownsNew('uid')
        && !(request.resource.data.get('flagWhy', '') == 'adult');
      allow update: if owns('uid') && sameOwner('uid') && adultOk();
      allow delete: if owns('uid');
    }
    match /comments/{id} {
      allow read: if signed();
      allow create: if ownsNew('uid');
      allow update: if owns('uid') && sameOwner('uid');
      allow delete: if owns('uid');
    }
    match /svc/{id} {
      allow read: if signed();
      allow create: if ownsNew('uid')
        && !(request.resource.data.get('flagWhy', '') == 'adult');
      allow update: if owns('uid') && sameOwner('uid') && adultOk();
      allow delete: if owns('uid');
    }
    match /imgs/{id} {
      allow read: if signed();
      allow create: if ownsNew('uid');
      allow update: if owns('uid') && sameOwner('uid');
      allow delete: if owns('uid');
    }

    // রিঅ্যাকশন/লাইক/শেয়ার/রেটিং: ডক আইডি অবশ্যই "লক্ষ্য_uid", তাই এক জন এক বারই দিতে পারে
    match /likes/{id} {
      allow read: if signed();
      allow create, update: if ownsNew('uid') && id == request.resource.data.postId + '_' + me();
      allow delete: if owns('uid');
    }
    match /shares/{id} {
      allow read: if signed();
      allow create, update: if ownsNew('uid') && id == request.resource.data.postId + '_' + me();
      allow delete: if owns('uid');
    }
    match /cReacts/{id} {
      allow read: if signed();
      allow create, update: if ownsNew('uid') && id == request.resource.data.commentId + '_' + me();
      allow delete: if owns('uid');
    }
    match /rate/{id} {
      allow read: if signed();
      allow create, update: if ownsNew('uid')
        && id == request.resource.data.svcId + '_' + me()
        && request.resource.data.stars is number
        && request.resource.data.stars >= 1 && request.resource.data.stars <= 5;
      allow delete: if owns('uid');
    }
    match /pReacts/{id} {
      allow read: if signed();
      allow create: if ownsNew('uid');
      allow update: if owns('uid') && sameOwner('uid');
      allow delete: if owns('uid');
    }

    // পোল ভোট: আইডি "postId_uid", তাই এক জনের এক ভোট (বদলানো যাবে), অপশন ০–৩
    match /pvotes/{id} {
      allow read: if signed();
      allow create, update: if ownsNew('uid')
        && id == request.resource.data.postId + '_' + me()
        && request.resource.data.opt is int
        && request.resource.data.opt >= 0 && request.resource.data.opt <= 3;
      allow delete: if owns('uid');
    }

    match /saved/{id} {
      allow read, delete: if owns('uid');
      allow create: if ownsNew('uid');
    }
    match /pins/{id} {
      allow read, delete: if owns('uid');
      allow create: if ownsNew('uid');
    }
    match /follows/{id} {
      allow read: if signed();
      allow create: if ownsNew('from');
      allow delete: if owns('from');
    }
    match /reports/{id} {
      allow read: if signed();
      allow create: if ownsNew('uid');
    }

    match /msgs/{id} {
      allow read: if signed() && me() in resource.data.members;
      allow create: if signed() && (
        (request.resource.data.from == me()
          && me() in request.resource.data.members
          && !exists(/databases/$(db)/documents/blocks/$(request.resource.data.to + '_' + me()))) ||
        (request.resource.data.from == 'vimline_bot' && request.resource.data.to == me()));
      allow update: if owns('from') && sameOwner('from')
        && request.resource.data.members == resource.data.members;
      allow delete: if signed() && me() in resource.data.members;
    }
    match /groups/{id} {
      allow read: if signed() && me() in resource.data.members;
      allow create: if signed() && me() in request.resource.data.members
        && request.resource.data.creator == me();
      allow update: if signed() && me() in resource.data.members && sameOwner('creator');
      allow delete: if owns('creator');
    }
    match /gmsgs/{id} {
      allow read: if signed() && me() in resource.data.members;
      allow create: if signed() && request.resource.data.from == me();
      allow update: if owns('from') && sameOwner('from');
      allow delete: if owns('from');
    }
    match /calls/{id} {
      allow read, write: if signed() && (
        me() in resource.data.members || me() in request.resource.data.members);
    }
    match /ice/{id} {
      allow read: if owns('to');
      allow create: if ownsNew('from');
      allow delete: if signed() && (resource.data.to == me() || resource.data.from == me());
    }

    // ভয়েস: শুধু মালিক লিখতে/মুছতে পারবে
    match /voices/{id} {
      allow read: if signed();
      allow create: if ownsNew('uid');
      allow update: if owns('uid') && sameOwner('uid');
      allow delete: if owns('uid');
    }
    // চ্যাটের মিডিয়া: শুধু ওই চ্যাটের দুই জন পড়তে পারবে
    match /mmedia/{id} {
      allow read: if signed() && me() in resource.data.members;
      allow create: if ownsNew('uid') && me() in request.resource.data.members;
      allow update: if owns('uid') && sameOwner('uid');
      allow delete: if signed() && me() in resource.data.members;
    }
    // শিডিউল পোস্ট: শুধু মালিক দেখতে/বানাতে/মুছতে পারবে; Cloud Function সময় হলে পোস্ট করে দেয়
    match /scheduled/{id} {
      allow read, delete: if owns('uid');
      allow create: if ownsNew('uid') && request.resource.data.at is number
        && request.resource.data.at > request.time.toMillis();
    }
    // স্টোরি: ২৫ ঘণ্টার বেশি মেয়াদ বসানো যাবে না; এডিট নেই, শুধু মালিক মুছতে পারবে
    match /stories/{id} {
      allow read: if signed();
      allow create: if ownsNew('uid')
        && request.resource.data.exp is number
        && request.resource.data.exp <= request.time.toMillis() + 90000000;
      allow delete: if owns('uid');
    }
    // 'mod' ও বাকি সব কালেকশনে ক্লায়েন্টের অ্যাক্সেস নেই
  }
}
